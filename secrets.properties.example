# Copie este arquivo para "secrets.properties" (mesma pasta) e preencha.
# Só é usado se você compilar no próprio PC (Android Studio).
# No GitHub, os mesmos valores vão em Settings > Secrets and variables > Actions.

# Conta de e-mail dedicada ao envio (Titan Mail)
SMTP_USER=rastreio@suaempresa.com.br
SMTP_PASSWORD=
# Para quem vai o relatório (vários: separe por vírgula)
MAIL_TO=voce@suaempresa.com.br

# Nome que aparece no relatório
DEVICE_LABEL=Vendedor 01

# PIN do painel de administrador (*#*#7278#*#* no discador)
ADMIN_PIN=

# Chave de assinatura (arquivo rastreio.jks na raiz do projeto)
KEYSTORE_PASSWORD=

# Normalmente não precisa mudar
#SMTP_HOST=smtp.titan.email
#SMTP_PORT=465
